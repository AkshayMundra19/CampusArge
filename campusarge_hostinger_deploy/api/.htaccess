<FilesMatch "^(config\.php|config\.local\.php|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Deny direct access to internal libraries and logs
    RewriteRule ^(lib|logs)/ - [F,L]
    
    # Pre-flight OPTIONS request for CORS handling
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
